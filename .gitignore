# Compressed archives
*.zip
*.rar
*.7z
*.tar
*.gz

# Installers and executable libraries
*.exe
*.dll
*.msi
*.iso

# Licenses, keys and private configuration
*.lic
*.license
*.key
*.pem
*.pfx
*.p12
.env
.env.*
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
ise_vivado_lic.zip

# Vivado generated/build directories
**/.Xil/
**/*.runs/
**/*.cache/
**/*.hw/
**/*.sim/
**/*.gen/
**/ip_user_files/
**/*.ip_user_files/
**/xsim.dir/

# Vivado temporary/runtime files
*.jou
*.str
*.pb
*.wdb
*.dcp
*.tmp
*.bak

# Compiler-generated content
Debug/
Release/
*.obj
*.o
*.out
*.map
*.pdb
*.log

# IDE and operating-system files
.vscode/
.idea/
.vs/
.metadata/
Thumbs.db
Desktop.ini
~$*

# Local GitHub automation work areas
_github_worktree/
_github_extract_staging/
_github_upload_logs/
.github_upload_logs/
_github_scan/

# PDF.js viewer build artifacts — fetched & trimmed by scripts/build-viewer.mjs.
# Not committed: keeps history clean and makes upgrades a one-line version bump.
viewer/build/
viewer/web/
viewer/LICENSE
# Generated by scripts/scan-pdfs.mjs; rebuilt on every Pages deploy.
viewer/pdf-index.json
# Temp dir used by the viewer build script.
_pdfjs_build_tmp/

# AI Reading Path build artifacts — generated in CI by scripts/build-ai-docs.py
# (embedded text + Tesseract OCR), published via the Pages artifact only.
viewer/ai/
